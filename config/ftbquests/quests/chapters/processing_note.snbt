		}
		{
			dependencies: [
				"1294A6C6E1A12EFB"
				"2B0465F2A53DB8ED"
				"31D8AA7BD7F225D1"
			]
			description: ["&eThe glass batch distributes its mineral components before firing. A uniform mixture avoids regions with different compositions when the batch is worked into a glass blank.&r"]
			disable_toast: true
			icon: "kubejs:glass_batch"
			id: "4F55DF87BD90F15D"
			subtitle: "A Workable Glass Composition"
