				type: "checkmark"
			}]
			title: "Sand"
			x: -4.5d
			y: -5.0d
		}
		{
			dependencies: ["7EAD0C34B17014A4"]
			description: ["&eIn conventional glassmaking, soda is a flux that allows silica to be worked at lower temperatures. It makes a silica-rich batch easier to melt and shape.&r"]
			disable_toast: true
			hide_dependency_lines: true
			icon: "kubejs:soda_powder"
			id: "2B0465F2A53DB8ED"
