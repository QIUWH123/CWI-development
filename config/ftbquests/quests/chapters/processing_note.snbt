			title: "Pressed Glass Blank"
			x: 0.0d
			y: -4.0d
		}
		{
			dependencies: ["4F55DF87BD90F15D"]
			description: ["&eFiring joins the loose batch into a solid blank. In sintering, heat bonds neighboring particles; the resulting piece can be handled and shaped instead of remaining a pile of powder.&r"]
			disable_toast: true
			icon: "kubejs:sintered_glass_blank"
			id: "078BB9F9932F52D8"
			subtitle: "Particle Bonding"
			tasks: [{
