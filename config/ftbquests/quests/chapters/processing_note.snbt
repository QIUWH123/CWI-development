			x: -3.0d
			y: -4.0d
		}
		{
			dependencies: ["7EAD0C34B17014A4"]
			description: ["&eSilica-rich sand supplies the main network-forming material of ordinary glass. Silica alone needs very high temperatures to work, so soda and limestone are used to make a more practical glass batch.&r"]
			disable_toast: true
			hide_dependency_lines: true
			icon: "minecraft:sand"
			id: "1294A6C6E1A12EFB"
			subtitle: "The Glass Network"
