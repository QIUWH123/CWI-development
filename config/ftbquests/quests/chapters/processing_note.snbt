			x: -6.0d
			y: -4.0d
		}
		{
			dependencies: ["7EAD0C34B17014A4"]
			description: ["&eLimestone supplies lime during conventional glass firing. Lime stabilizes soda-containing glass, helping it resist water instead of gradually dissolving at the surface.&r"]
			disable_toast: true
			hide_dependency_lines: true
			icon: "kubejs:limestone_powder"
			id: "31D8AA7BD7F225D1"
