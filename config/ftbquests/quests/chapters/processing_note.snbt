	quests: [
		{
			description: [
				"&eGlassmaking turns a loose mineral batch into a shaped, transparent solid. Ore processing has a different aim: separate useful material from the rock around it and recover what remains after the first pass.&r"
				""
				"&ePhysical separation sorts particles; chemical recovery changes the mineral compounds themselves. Choose a treatment compatible with the ore, and follow the tailings as well as the concentrate. The first separation does not recover everything.&r"
			]
			hide_dependent_lines: true
			id: "7EAD0C34B17014A4"
			invisible: true
			shape: "gear"
			size: 3.0d
			subtitle: "Glassmaking and Ore Recovery"
			tasks: [{
				id: "71385303C15031A6"
				item: "kubejs:processing_note"
				type: "item"
			}]
			title: "Processing Notes"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["6E14C5649AE916F6"]
			description: [
				"&eGlass provides a hard, transparent barrier for windows, vessels and fluid equipment. Unlike a crystal, its atoms have no repeating long-range arrangement.&r"
				""
				"&eIn conventional glassmaking, uneven cooling can cause cracking. Devitrification is a different defect: unwanted crystals form within the glass and can cloud it.&r"
			]
			disable_toast: true
			id: "486EA6444B07AE9E"
			shape: "rsquare"
			size: 1.5d
			subtitle: "Transparent Barriers"
			tasks: [{
				id: "1882244D0B7ED9A4"
				item: "minecraft:glass"
				type: "item"
			}]
			title: "Glass"
			x: 3.0d
			y: -4.0d
		}
		{
			dependencies: ["078BB9F9932F52D8"]
			description: ["&ePressing shapes the fired blank before its final cooling treatment. A regular shape is important for glass fitted into frames and vessels.&r"]
			disable_toast: true
			icon: "kubejs:pressed_glass_blank"
			id: "6E14C5649AE916F6"
			tasks: [{
				id: "34F8EC64F878F183"
