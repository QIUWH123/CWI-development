	order_index: 11
	quest_links: [ ]
	quests: [
		{
			description: ["&eHeavy industry brings higher furnace temperatures, stronger metal stock, and machinery built to handle sustained loads. These notes explain how the furnace and its supporting workshops make those conditions possible.&r"]
			hide_dependent_lines: true
			id: "7A0C6B3904C55546"
			invisible: true
			shape: "gear"
			size: 2.0d
			subtitle: "Industrial Workshop Handbook"
			tasks: [{
				id: "3471BB278B14DE85"
				item: "kubejs:industrial_manual"
				type: "item"
			}]
			title: "Heavy Industry"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: [
				"461B8FFD37D6D4A8"
				"34A1646F3FC3509B"
			]
			description: [
				"&eCast iron contains more carbon than steel. It flows well when molten, making it useful for cast bodies with shapes that would be difficult to forge. Its brittleness makes it less suitable for parts that must bend or absorb sharp impacts.&r"
				""
				"&eThe workshop uses it for pipes, tanks, chemical vats, and furnace components: rigid bodies that contain fluids or support machinery.&r"
			]
			disable_toast: true
			id: "3E0CF50CF54A7795"
			shape: "square"
			subtitle: "Cast Machine Bodies"
			tasks: [{
				id: "52F9478B200B748C"
				item: "tfmg:cast_iron_ingot"
				type: "item"
			}]
			title: "Cast Iron Ingot"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: [
				"5148FEA0B12D0880"
				"4B93583D74E7E010"
			]
			description: [
				"&eSteel combines iron with a controlled amount of carbon. Its strength and toughness make it useful for parts that transmit force or hold a machine together, including heavy plates, bearings, mechanisms, and furnace reinforcement.&r"
				""
				"&ePig iron is a different stock with a higher carbon content. The blast furnace produces pig iron; turning it into steel ordinarily requires further control of carbon and impurities.&r"
			]
			disable_toast: true
			id: "0635A293D5BA7EF2"
			shape: "square"
			tasks: [{
				id: "7942A16831EDA69A"
				item: "tfmg:steel_ingot"
				type: "item"
			}]
			title: "Steel Ingot"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["7A0C6B3904C55546"]
			description: [
				"   &3----------&r   &bRequires Fuel to Operate&r   &3----------&r"
				"&eThe coke oven heats coal with limited access to oxygen, driving off volatile compounds while leaving a carbon-rich solid. This produces coke for furnace work; wood can be treated here to make charcoal.&r"
				""
				"&eCreosote and carbon dioxide leave alongside the solid product. Drain carbon dioxide from the top and creosote from another face; a full fluid tank stops processing. Creosote also treats the wood used beneath industrial casings.&r"
			]
			disable_toast: true
			hide_dependency_lines: true
			id: "09E6FDDC7DCCD8E3"
			shape: "hexagon"
			size: 1.5d
			tasks: [{
				id: "471C4245F65D97F6"
				item: "tfmg:coke_oven"
				type: "item"
			}]
			title: "Coke Oven"
			x: 2.0d
			y: -4.0d
		}
		{
			dependencies: ["09E6FDDC7DCCD8E3"]
			description: [
				"&eCoke is the carbon-rich solid left after coking coal. Industrial furnaces historically used it as both a fuel and a reducing material.&r"
				""
				"&eGround coke supplies carbon to heated industrial iron and silicon production. In reduction processes, carbon helps remove oxygen from mineral compounds; it is a chemical ingredient as well as a source of heat.&r"
			]
			disable_toast: true
			id: "4784F318EADDD9C3"
			subtitle: "Coal after Coking"
			tasks: [{
				id: "66AC72A9F1107284"
				item: "tfmg:coal_coke"
				type: "item"
			}]
			title: "Coal Coke"
			x: 0.0d
			y: -4.0d
		}
		{
			dependencies: [
				"3E0CF50CF54A7795"
				"49EB4FE7D42831FA"
				"337E1339823083A2"
			]
			description: [
				"&eThe blast furnace processes iron-bearing material into molten pig iron and slag, and can also recover liquid silicon from quartz. High heat enables these reactions; limestone helps carry unwanted compounds into the separate slag output.&r"
				""
				"&eHeaters beneath the furnace supply heat, while reinforcement sets its temperature ceiling. The temperature rises gradually: heated operation begins at 1200, and superheated operation at 1900. The pig-iron and silicon reactions require superheating.&r"
			]
			disable_toast: true
			id: "5148FEA0B12D0880"
			shape: "hexagon"
			size: 1.5d
			subtitle: "Furnace Commissioning"
			tasks: [{
				id: "053DC5CC9134C583"
				item: "cwi:blast_furnace"
				type: "item"
			}]
			title: "Blast Furnace"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["4DADEE61B50B2B74"]
			description: ["&eFireproof brick blocks form refractory furnace linings and casting equipment. Their heat-resistant mineral body keeps the vessel intact at temperatures that would damage ordinary masonry.&r"]
			disable_toast: true
			id: "49EB4FE7D42831FA"
			subtitle: "Refractory Masonry"
			tasks: [{
				id: "12E0D24622EA9C27"
				item: "tfmg:fireproof_bricks"
				type: "item"
			}]
			title: "Fireproof Bricks"
			x: 4.0d
			y: 2.0d
		}
		{
			dependencies: ["14B9150E857D89D3"]
			description: [
				"&eFiring converts the soft fireclay blend into a rigid refractory brick. These bricks supply furnace masonry and components exposed to molten material.&r"
				""
				"&eMold stock must be shaped into a disk before firing. Once fired, the material has the heat resistance needed for casting rather than the softness needed for initial shaping.&r"
			]
			disable_toast: true
			id: "4DADEE61B50B2B74"
			shape: "square"
			subtitle: "Brick or Mold Stock"
			tasks: [{
				id: "477046D248E52059"
				item: "tfmg:fireproof_brick"
				type: "item"
			}]
			title: "Fireproof Brick"
			x: 4.0d
			y: 4.0d
		}
		{
			dependencies: ["3E0CF50CF54A7795"]
			description: ["&eThe air intake uses rotation to collect atmospheric air for industrial processing. Steel refining uses the oxygen in this air to remove excess carbon from molten pig iron.&r"]
			disable_toast: true
			id: "13C9C9F227B312DD"
			shape: "hexagon"
			size: 1.5d
			tasks: [{
				id: "20BCC4EC39AED10F"
				item: "tfmg:air_intake"
				type: "item"
			}]
			title: "Air Access"
			x: 4.0d
			y: -2.0d
		}
		{
			dependencies: ["3E0CF50CF54A7795"]
			description: [
				"&eA furnace hatch provides ingredient access through the blast furnace's refractory wall. Connect item transport and pipes to supply solid feed and molten ingredients.&r"
				""
				"&eKeep molten pig iron and liquid silicon on separate supply lines. Collect molten products from the furnace's output rather than through the hatch.&r"
			]
			disable_toast: true
			id: "337E1339823083A2"
			shape: "hexagon"
			size: 1.5d
			tasks: [{
				id: "43B5A7B03E49F313"
				item: "cwi:furnace_hatch"
				type: "item"
			}]
			title: "Furnace Hatch"
			x: 2.0d
			y: 2.0d
		}
		{
			dependencies: [
				"5CB3035210A39A5F"
				"307C9A0994617AEA"
				"09A16A54841462D0"
				"6DFB21A13808280F"
			]
			description: [
				"&eFireclay is a workable mineral blend for refractory masonry. Clay gives the unfired stock its shaping properties; the mineral additives prepare it for use around intense heat.&r"
				""
				"&eThe same stock becomes furnace bricks or casting molds, depending on how it is shaped before firing.&r"
			]
			disable_toast: true
			id: "14B9150E857D89D3"
			subtitle: "Fireclay Blend"
			tasks: [{
				id: "33967496483FF39B"
				item: "tfmg:fireclay_ball"
				type: "item"
			}]
			title: "Fireclay Ball"
			x: 2.0d
			y: 4.0d
		}
		{
			dependencies: ["7A0C6B3904C55546"]
			description: ["&eBauxite is rich in aluminum-bearing minerals and is the principal ore used for aluminum production. Its alumina content also makes it useful in refractories; powdered bauxite is part of the fireclay blend.&r"]
			disable_toast: true
			hide_dependency_lines: true
			id: "307C9A0994617AEA"
			subtitle: "Bauxite in Refractories"
			tasks: [{
				id: "65314E54C8FBBB97"
				item: "kubejs:bauxite_powder"
				type: "item"
			}]
			title: "Bauxite Powder"
			x: 0.0d
			y: 2.0d
		}
		{
			dependencies: ["7A0C6B3904C55546"]
			description: [
				"&eSilicon is a metalloid widely used in alloys and semiconductor electronics. Quartz contains silicon bound to oxygen; carbon reduction provides a route to separate silicon-bearing stock from that mineral.&r"
				""
				"&eThe workshop uses silicon powder as an alternative to quartz powder in fireclay.&r"
			]
			disable_toast: true
			hide_dependency_lines: true
			id: "5CB3035210A39A5F"
			subtitle: "Silicon and Refractories"
			tasks: [{
				id: "7A80B4CA2B0BF9F0"
				item: "kubejs:silicon_powder"
				type: "item"
			}]
			title: "Silicon Powder"
			x: 0.0d
			y: 4.0d
		}
		{
			dependencies: ["7A0C6B3904C55546"]
			description: ["&eMagnesite is magnesium carbonate. Magnesium-bearing refractories have long served furnace linings exposed to severe heat; the workshop uses magnesite powder as a fireclay additive.&r"]
			disable_toast: true
			hide_dependency_lines: true
			id: "09A16A54841462D0"
			subtitle: "Magnesite Additive"
			tasks: [{
				id: "1399CB6A28A8469E"
				item: "kubejs:magnesite_powder"
				type: "item"
			}]
			title: "Magnesite Powder"
			x: 0.0d
			y: 6.0d
		}
		{
			dependencies: [
				"33288F9895EE3A5E"
				"5742E5A99ED7CEF1"
			]
			description: ["&eA steel casing encloses the machine's working parts in a plated body. Hardened wood provides the base, while the steel exterior forms the casing used by centrifuges and other industrial assemblies.&r"]
			id: "7F050F2D70CEA448"
			shape: "rsquare"
			size: 1.75d
			tasks: [{
				id: "4D9D2D44DFEBC788"
				item: "tfmg:steel_casing"
				type: "item"
			}]
			title: "Steel Casing"
			x: 8.0d
			y: -2.0d
		}
		{
			dependencies: ["5742E5A99ED7CEF1"]
			description: ["&eThe heavy machinery casing reinforces a steel casing with more steel and heavy plates. It houses heavy machine cores, pumpjack equipment, and refinery assemblies.&r"]
			id: "213E8A29FFD8F2F6"
			shape: "rsquare"
			size: 1.75d
			subtitle: "Reinforced Machine Body"
			tasks: [{
				id: "0A70FC9BF912EC2A"
				item: "tfmg:heavy_machinery_casing"
				type: "item"
			}]
			title: "Heavy Machinery Casing"
			x: 10.0d
			y: 0.0d
		}
		{
			dependencies: ["0635A293D5BA7EF2"]
			description: ["&eHeavy plates are steel stock used where a broad metal surface must contain, protect, or support something. Tanks use them for walls, casings for enclosures, and armor for protective panels; mechanisms and tools also depend on this stock.&r"]
			disable_toast: true
			id: "5742E5A99ED7CEF1"
			tasks: [{
				id: "00A8A83AA19B71F6"
				item: "tfmg:heavy_plate"
				type: "item"
			}]
			title: "Heavy Plate"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["5742E5A99ED7CEF1"]
			description: [
				"&eSteel reinforcement supports the furnace's refractory structure and raises its permitted temperature ceiling. Heat supply and structural support are separate requirements: stronger heaters cannot push an inadequately reinforced furnace beyond that limit.&r"
				""
				"&eFresh reinforcement contributes more than rusted reinforcement. Both support the furnace, but their condition matters when seeking superheated operation.&r"
			]
			disable_toast: true
			id: "7D93855EB57F68E5"
			shape: "hexagon"
			size: 1.5d
			subtitle: "Furnace Temperature Limit"
			tasks: [{
				id: "53AF58ACC8D7D86D"
				item: "tfmg:blast_furnace_reinforcement"
				type: "item"
			}]
			title: "Blast Furnace Reinforcement"
			x: 8.0d
			y: 2.0d
		}
		{
			dependencies: ["72BBEB2B8E9363AB"]
			description: ["&eHardened wood is quality sealed wood treated further with creosote. Timber preservatives resist decay and weathering, making treated wood useful as the lasting base beneath a steel casing.&r"]
			disable_toast: true
			id: "33288F9895EE3A5E"
			subtitle: "Preserved Casing Base"
			tasks: [{
				id: "71517F0A0693C35F"
				item: "kubejs:harden_wood"
				type: "item"
			}]
			title: "Hardened Wood"
			x: 6.0d
			y: -2.0d
		}
		{
			dependencies: ["7A0C6B3904C55546"]
			description: ["&eFine clay particles become workable with water, allowing shaped pieces to be dried or fired. The workshop uses clay in fireclay, cement, mortar, and casting molds.&r"]
			disable_toast: true
			hide_dependency_lines: true
			id: "6DFB21A13808280F"
			tasks: [{
				id: "7C030214A8273473"
				item: "minecraft:clay_ball"
				type: "item"
			}]
			title: "Clay Ball"
			x: 2.0d
			y: 6.0d
		}
		{
			dependencies: ["09E6FDDC7DCCD8E3"]
			description: ["&eCreosote is an oily mixture recovered during coking, historically used to preserve timber against decay. The workshop uses it on ordinary planks and quality sealed wood, supplying treated stock for the centrifuge and steel casings.&r"]
			disable_toast: true
			id: "72BBEB2B8E9363AB"
			subtitle: "Keep the Coking Byproduct"
			tasks: [{
				id: "27F49C90ECC65A2E"
				item: "kubejs:creosote_bucket"
				type: "item"
			}]
			title: "Creosote"
			x: 4.0d
			y: -4.0d
		}
		{
			dependencies: ["4784F318EADDD9C3"]
			description: ["&eGrinding coke spreads its carbon through a batch instead of leaving it in large lumps. Coke dust supplies carbon to heated industrial iron and helps reduce quartz during silicon production.&r"]
			disable_toast: true
			id: "461B8FFD37D6D4A8"
			tasks: [{
				id: "34124BBFCA8DAEA6"
				item: "tfmg:coal_coke_dust"
				type: "item"
			}]
			title: "Coal Coke Dust"
			x: 2.0d
			y: -2.0d
		}
		{
			dependencies: ["7A0C6B3904C55546"]
			description: [
				"&eLimestone is largely calcium carbonate. In ironmaking, lime derived from it helps collect unwanted compounds into slag.&r"
				""
				"&eIts powder is used in heated industrial iron, silicon, cement, and the blast furnace's pig-iron recipes.&r"
			]
			disable_toast: true
			hide_dependency_lines: true
			id: "34A1646F3FC3509B"
			subtitle: "Limestone as a Process Additive"
			tasks: [{
				id: "43235D5BFDAF9C4F"
				item: "kubejs:limestone_powder"
				type: "item"
			}]
			title: "Limestone Powder"
			x: 0.0d
			y: -2.0d
		}
		{
			dependencies: ["72BBEB2B8E9363AB"]
			description: ["&eCreosote-treated planks provide wooden structural stock for the centrifuge. They are treated ordinary planks; the hardened wood used beneath steel casings is a separate product made from quality sealed wood.&r"]
			disable_toast: true
			id: "70556A32DA19E441"
			shape: "diamond"
			subtitle: "Treat the Planks Directly"
			tasks: [{
				id: "5AD2D3D030ACF624"
				item: "tfmg:hardened_planks"
				type: "item"
			}]
			title: "Hardened Planks"
			x: 6.0d
			y: -4.0d
		}
		{
			dependencies: ["4DADEE61B50B2B74"]
			description: ["&eThe casting basin contains a melt while it cools into a block. It supplies solid storage stock directly from molten metal and turns furnace slag into blocks, giving the fluid output a form that can be stored or used in construction.&r"]
			disable_toast: true
			id: "5C5628BB82D53C81"
			shape: "hexagon"
			size: 1.5d
			subtitle: "Block Casting"
			tasks: [{
				id: "429620DCD4A9043A"
				item: "createmetallurgy:casting_basin"
				type: "item"
			}]
			title: "Casting Basin"
			x: 6.0d
			y: 4.0d
		}
		{
			dependencies: ["4DADEE61B50B2B74"]
			description: [
				"&eThe firebox burns liquid fuel supplied through pipes, transferring combustion heat to compatible machinery above it. The fuel burns in a separate chamber beneath the vessel, heating the contents without adding the fuel to the batch.&r"
				""
				"&eCombustion also produces carbon dioxide. Pump this exhaust out continuously: when its exhaust tank fills, the firebox stops burning even if fuel remains.&r"
			]
			disable_toast: true
			id: "1AC4C7E11C7A406E"
			shape: "hexagon"
			size: 1.5d
			subtitle: "Liquid Fuel and Exhaust"
			tasks: [{
				id: "2C5E85DE64CB14A6"
				item: "tfmg:firebox"
				type: "item"
			}]
			title: "Firebox"
			x: 4.0d
			y: 6.0d
		}
		{
			dependencies: ["5531421570274E82"]
			description: [
				"&eSteel cogwheels and a bearing form a supported gear assembly. The gears transmit rotation between parts, while the bearing supports their movement; fastening keeps their positions fixed.&r"
				""
				"&eThis mechanism supplies the working assembly in industrial machine cores, chemical vats, and petroleum equipment.&r"
			]
			disable_toast: true
			id: "08C023B7583B9161"
			shape: "rsquare"
			size: 1.5d
			tasks: [{
				id: "15FEAB67600B7431"
				item: "tfmg:steel_mechanism"
				type: "item"
			}]
			title: "Steel Mechanism"
			x: 12.0d
			y: 2.0d
		}
		{
			dependencies: ["5742E5A99ED7CEF1"]
			description: [
				"&eA bearing supports a rotating part while allowing it to turn. Its rolling elements reduce sliding contact between the moving part and its housing, limiting friction and helping the shaft stay aligned.&r"
				""
				"&eSteel bearings are used in mechanisms, industrial pumps, pumpjack cranks, and heavy machine cores.&r"
			]
			disable_toast: true
			id: "5531421570274E82"
			shape: "rsquare"
			size: 1.5d
			tasks: [{
				id: "666A88C414E59C27"
				item: "kubejs:steel_bearing"
				type: "item"
			}]
			title: "Steel Bearing"
			x: 10.0d
			y: 2.0d
		}
		{
			dependencies: ["5C5628BB82D53C81"]
			description: [
				"&eSlag is the mineral-rich output separated from metal during furnace processing. Limestone-derived flux helps collect unwanted compounds into this phase, keeping them apart from the pig iron.&r"
				""
				"&eCast slag can serve as construction aggregate, including in asphalt mixture. Both slag and metal need an outlet for furnace processing to continue.&r"
			]
