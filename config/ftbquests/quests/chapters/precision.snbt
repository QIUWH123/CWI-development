		{
			dependencies: [
				"12887B78FD9C72DA"
				"5518FD26FF090152"
			]
			description: [
				"&eThe deployer repeats the action of a hand: applying ingredients, using tools, or interacting with the block in front of it. Rotation drives its repeated strokes.&r"
				""
				"&eThis makes it useful for assembly operations that require contact with a workpiece rather than grinding or heating it. The held item determines the action.&r"
			]
			disable_toast: true
			id: "00C03DD3A3903E7C"
			shape: "hexagon"
			size: 1.5d
			subtitle: "Repeating a Hand Operation"
			tasks: [{
				id: "200F0D7440714DA2"
				item: "create:deployer"
				type: "item"
			}]
			title: "Deployer"
			x: 4.0d
			y: 2.0d
		}
		{
			dependencies: ["00206C2F04A626DB"]
			description: [
				"&eIn conventional electronics, a vacuum tube controls current between electrodes inside an evacuated enclosure. A diode passes current in one direction; tubes with additional electrodes can regulate or amplify a signal.&r"
				""
				"&eThe workshop uses electron tubes in control chips and precise machine cores. These assemblies give machines controlled actions: deployers repeat tool operations, and filtered transport selects which materials pass.&r"
				""
				"&cHandle it carefully, could be factured if it falls on the ground.&r"
			]
			disable_toast: true
			id: "785427A61D5C6471"
			subtitle: "A One-Way Signal Element"
			tasks: [{
				id: "2C84EBCBDD918BE9"
				item: "create:electron_tube"
				type: "item"
			}]
			title: "Electron Tube"
			x: 0.0d
			y: 4.0d
		}
		{
			dependencies: ["53BF409251D93EE1"]
			description: [
				"&eEach mechanical crafter holds one ingredient position. Connected crafters pass those ingredients toward a final assembly point, so a large machine can be built from a pattern spread across several blocks.&r"
				""
				"&eThe output arrows define that route; slot covers preserve empty positions in the pattern. This supplies the large crafting layouts required by later machinery.&r"
			]
			disable_toast: true
			id: "7B2506C2B1F67B51"
			shape: "hexagon"
			size: 1.5d
			subtitle: "Arrange the Crafting Network"
