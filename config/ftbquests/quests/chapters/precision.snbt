	order_index: 10
	quest_links: [ ]
	quests: [
		{
			description: [
				"&eThe package from the brass lockbox contains the precision manual, processing notes, and a manufacturing engineer's log. Cut the wrapping open before separating the documents.&r"
				""
				"&eThese pages explain how to reproduce components without their original makers. A working assembly line can then supply its own replacements.&r"
				""
				"&eA note on the cover reads: 'Restoration copy — project engineering.' Beneath it, the initials look familiar.&r"
			]
			hide_dependent_lines: true
			id: "32BA01C17B48E245"
			invisible: true
			shape: "gear"
			size: 2.0d
			subtitle: "Workshop Instruction Copy"
			tasks: [{
				id: "2CEE9B57BFF8DB7F"
				item: "kubejs:precision_manual"
				type: "item"
			}]
			title: "Precision Manufacturing"
			x: -2.0d
			y: 0.0d
		}
		{
			dependencies: ["32BA01C17B48E245"]
			description: ["&eBrass is a copper-zinc alloy. Its machinability suits small fittings and gear parts, while its conductivity suits electrical contacts. In this workshop, brass sheets, wire, and nuggets serve both the moving assemblies and their control circuits.&r"]
			disable_toast: true
			hide_dependency_lines: true
			id: "51B224D51AE9FFAD"
			shape: "square"
			subtitle: "An Alloy for Small Parts"
			tasks: [{
				id: "3AF05ADCD1A40C7F"
				item: "create:brass_ingot"
				type: "item"
			}]
			title: "Brass Ingot"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["68973D217B4EDAB9"]
			description: [
				"&eA brass casing encloses the small moving parts and circuits of precision machinery. Its prepared wooden body supports the fittings; the metal covering forms the outer enclosure.&r"
				""
				"&eBrass is readily worked into accurate fittings, which makes it useful for deployers, mechanical crafters, and the precise machine core.&r"
			]
			id: "12887B78FD9C72DA"
			shape: "rsquare"
			size: 1.75d
			subtitle: "An Enclosure for Precision Parts"
			tasks: [{
				id: "59554561A9869559"
				item: "create:brass_casing"
				type: "item"
			}]
			title: "Brass Casing"
			x: 2.0d
			y: 2.0d
		}
		{
			dependencies: ["51EF890D08BB88B8"]
			description: [
				"&eBronze is a copper-tin alloy. Its long history in tools and cast objects predates modern steelmaking; its composition can be adjusted to suit different work.&r"
				""
				"&eTin changes the hardness and wear behavior of the copper alloy. The workshop uses bronze in tools and armor, as well as the rods and wire of railway and steam equipment.&r"
			]
			disable_toast: true
			id: "549E4EE23C1A3AB8"
			shape: "square"
			subtitle: "Copper with Tin"
			tasks: [{
				id: "62800B31CA89B1CA"
				item: "kubejs:bronze_ingot"
				type: "item"
			}]
			title: "Bronze Ingot"
			x: 8.0d
			y: -2.0d
		}
		{
			dependencies: [
				"00C03DD3A3903E7C"
				"68973D217B4EDAB9"
			]
			description: [
				"&eThe precision mechanism is designed to keep moving parts in step. Meshing gear teeth set the relationship between rotations; accurate alignment keeps the gears engaging consistently as they turn.&r"
				""
				"&ePrecise machine cores and mechanical arm bases use this mechanism. An arm repeatedly returns to selected pickup and delivery points, where consistent motion matters.&r"
				""
				"&cHandle it carefully, could be factured if it falls on the ground.&r"
			]
			disable_toast: true
			id: "1D16D3568A4B56AC"
			shape: "rsquare"
			size: 1.5d
			subtitle: "Keeping Motion in Step"
			tasks: [{
				id: "0774B32C9FEA408F"
				item: "create:precision_mechanism"
				type: "item"
			}]
			title: "Precision Mechanism"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: [
				"1D16D3568A4B56AC"
				"00C03DD3A3903E7C"
			]
			description: ["&eThe precise machine core combines the workshop's moving mechanism with its basic circuit control. It is used in mechanical crafters, lathes, and incubators: machines that repeat a controlled operation, whether assembling a workpiece, shaping a part, or developing a sealed culture.&r"]
			id: "53BF409251D93EE1"
			shape: "rsquare"
			size: 2.0d
			tasks: [{
				id: "20D912C588434E59"
				item: "kubejs:precise_machine"
				type: "item"
			}]
			title: "Precise Machine Core"
			x: 6.0d
			y: 2.0d
		}
		{
			dependencies: ["51EF890D08BB88B8"]
			description: ["&eIndustrial iron is worked construction stock for drill heads, cutting blades, springs, and machine frames. These parts repeatedly carry force or contact the workpiece, so their metal must withstand more demanding service than a simple cover or fitting.&r"]
			disable_toast: true
			id: "612A2B07C4F613E6"
			shape: "square"
			subtitle: "Metal for Working Parts"
			tasks: [{
				id: "3D58417254FBFD77"
				item: "kubejs:industrial_iron_ingot"
				type: "item"
			}]
			title: "Industrial Iron Ingot"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["1D16D3568A4B56AC"]
			description: [
				"   &3-----&r   &bSupports Superheating&r   &3-----&r "
				""
				"&eThe module feeds liquid fuel into a blaze burner, turning a piped supply into heat for melting, alloying, and other heated processes. Continuous delivery lets the burner remain supplied while a production line runs.&r"
				""
				"&eThe burner can reach the stronger heat required by advanced processing when supplied with a suitable liquid fuel.&r"
			]
			disable_toast: true
			id: "51EF890D08BB88B8"
			shape: "hexagon"
			size: 1.5d
			subtitle: "Heat from Liquid Fuel"
			tasks: [{
				id: "12D193F968B2CEF9"
				item: "createaddition:straw"
				type: "item"
			}]
			title: "Fluid Combustion Module"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["61B2E0C63F00A944"]
			description: [
				"&eThe steam apparatus is a compact piston assembly for engines and powered tools. In a steam-driven mechanism, pressure acts on the piston face and produces a working stroke; the linked mechanism passes that movement to the tool.&r"
				""
				"&ePortable drills, powered suits, and the Stirling engine use this assembly as part of their drive. The heat source and working cycle belong to the finished machine.&r"
			]
			disable_toast: true
			id: "3CC959E1243E962E"
			subtitle: "Steam Equipment Subassembly"
			tasks: [{
				id: "2086A44BD5849958"
				item: "kubejs:steam_apparatus"
				type: "item"
			}]
			title: "Steam Apparatus"
			x: 12.0d
			y: -2.0d
		}
		{
			dependencies: ["612A2B07C4F613E6"]
			description: [
				"&eA piston moves inside a cylinder. Pressure acting across its face pushes it along the bore, and a connecting mechanism transfers that stroke to the rest of the engine. A close fit limits leakage while leaving room for movement.&r"
				""
				"&eSteam apparatus, Stirling engines, and powered suits use these pistons to turn pressure changes into useful motion.&r"
			]
			disable_toast: true
			id: "61B2E0C63F00A944"
			subtitle: "Pressure into Motion"
			tasks: [{
				id: "0128972083BC8E2E"
				item: "createdieselgenerators:engine_piston"
				type: "item"
			}]
			title: "Engine Piston"
			x: 10.0d
			y: -2.0d
		}
		{
			dependencies: [
				"233D8C38E18799CF"
				"25C5F3ED706FFA9C"
			]
			description: [
				"&eA lathe rotates the workpiece against a cutting tool, removing material around its axis to form round parts. This controlled shape matters for pistons that must fit a bore and drill heads that must rotate evenly.&r"
				""
				"&eThe workshop also uses the lathe to prepare blades and curving heads.&r"
			]
			disable_toast: true
			id: "7A7EB90A68EA8845"
			shape: "hexagon"
			size: 1.5d
			subtitle: "Shaping a Rotating Workpiece"
			tasks: [{
				id: "40EB2155EC2FD3DA"
				item: "vintageimprovements:lathe"
				type: "item"
			}]
			title: "Lathe"
			x: 12.0d
			y: 4.0d
		}
		{
			dependencies: ["2EB25FBA5BA0E442"]
			description: [
				"&ePolished rose quartz is the finished crystal used in electron tubes and other precision components.&r"
				""
				"&cHandle it carefully, could be factured if it falls on the ground.&r"
			]
			disable_toast: true
			id: "00206C2F04A626DB"
