	quests: [
		{
			description: [
				"&eCold. You wake in a derelict laboratory. The equipment is silent. You cannot remember how long you have been here.&r"
				""
				"&eThe first page of this recovery memo is in handwriting you recognize:&r"
				""
				"&eYou know how to follow the instructions. You do not remember writing them.&r"
			]
			disable_toast: true
			hide_until_deps_complete: true
			icon: "kubejs:rusted_industrial_aluminum_casing"
			id: "48FAA6DBC81EED3F"
			shape: "gear"
			size: 2.5d
			subtitle: "Where Am I?"
			tasks: [{
				dimension: "minecraft:overworld"
				icon: "kubejs:rusted_industrial_aluminum_casing"
				id: "559365AE1AFEB82A"
				title: "Awaken in the Overworld"
				type: "dimension"
			}]
			title: "A Derelict Laboratory"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["48FAA6DBC81EED3F"]
			description: ["&eA chest near the exit, in plain view. Tools and a few rations. Whoever put it here expected someone to need them on the way out.&r"]
			id: "737A920A90D7A43F"
			size: 1.5d
			subtitle: "Left in Plain View"
			tasks: [{
				icon: "minecraft:chest"
				id: "789C0595276C26EF"
