			}]
			title: "Survival Supplies"
			x: -2.5d
			y: -2.5d
		}
		{
			dependencies: ["48FAA6DBC81EED3F"]
			description: [
				"&eYou know this ring. You remember standing here, though you cannot recall what you were waiting for.&r"
				""
				"&eBeyond that, only fragments: a voice from the control room, your hand resting on a drawing. The rest will not come.&r"
				""
				"&eWhatever happened here left the gate unusable. Familiarity will not put it back together.&r"
			]
			icon: "create_connected:music_disc_interlude"
			id: "1206CB23534B30CD"
			size: 1.5d
			tasks: [{
				id: "417448A9C37F1C8C"
