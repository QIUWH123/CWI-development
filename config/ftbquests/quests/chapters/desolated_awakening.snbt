				id: "559365AE1AFEB82A"
				title: "Where Am I"
				type: "dimension"
			}]
			title: "A Derelict Laboratory"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["48FAA6DBC81EED3F"]
			description: ["&eNear the exit, a chest. It wasn't hidden – whoever left it wanted it found. Basic tools, scraps of food. Enough to take the first breath outside.&r"]
			id: "737A920A90D7A43F"
			size: 1.5d
			subtitle: "Basic Tools and Food For Survival"
			tasks: [{
