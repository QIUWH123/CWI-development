	quests: [
		{
			description: ["&eCold. Silence. The hum of old machinery. This place was sealed for a long time, and now the air moves again. Something woke you. Something waited.&r"]
			disable_toast: true
			hide_until_deps_complete: true
			icon: "kubejs:rusted_industrial_aluminum_casing"
			id: "48FAA6DBC81EED3F"
			shape: "gear"
			size: 2.5d
			subtitle: "Where Am I?"
			tasks: [{
				dimension: "minecraft:overworld"
