		{
			dependencies: ["5C58A1D7357251A1"]
			description: [
				"&ePolypropylene is a lightweight thermoplastic made from propylene units. Its resistance to many chemicals and ability to form tough fibers make it useful in containers, textiles, and molded parts.&r"
				""
				"&eLike polyethylene, it can be reshaped by heating and cooling. Its different chain structure gives it different stiffness and heat behavior.&r"
			]
			disable_toast: true
			id: "5559F2157588513F"
			shape: "square"
			tasks: [{
				id: "10F647FCF3D43EBC"
