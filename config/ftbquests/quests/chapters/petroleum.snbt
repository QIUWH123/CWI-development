			x: 10.0d
			y: 0.0d
		}
		{
			dependencies: ["56CD87E991F1847E"]
			description: [
				"&ePVC is a chlorine-containing thermoplastic. Its rigid forms are widely used for pipes and profiles; additives can make it flexible enough for coverings and cable insulation.&r"
				""
				"&eThe refinery provides it as cast stock and sheets, turning vinyl chloride chemistry into a solid material that can be shaped and handled.&r"
			]
			disable_toast: true
			id: "6BED6C70FDA0D4A7"
			shape: "square"
