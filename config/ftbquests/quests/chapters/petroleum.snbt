		}
		{
			dependencies: ["2BB7B30F3B59D458"]
			description: [
				"&eNaphtha is a lighter petroleum fraction whose hydrocarbons serve as starting material for chemical manufacture. Steam cracking breaks larger molecules into smaller ones, supplying ethylene and propylene for plastics.&r"
				""
				"&eReforming offers a different use: it rearranges hydrocarbons into a mixture from which aromatic chemicals can be recovered. Naphtha therefore links crude refining to both polymer and aromatic chemistry.&r"
			]
			disable_toast: true
			hide_dependency_lines: true
			id: "28F5C1BA9431AF60"
			subtitle: "Naphtha as Feedstock"
			tasks: [{
				id: "7DC916E7F2D0EBDA"
