				type: "item"
			}]
			title: "Naphtha"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: [
				"2BB7B30F3B59D458"
				"71A1E5FE72C80780"
			]
			description: [
				"&eHeavy oil is a viscous petroleum stock used for rubber sheets and bitumen.&r"
				""
				"&eIt is a separate stock from residual oil and wax oil.&r"
			]
			disable_toast: true
			id: "21FEFC379E961856"
