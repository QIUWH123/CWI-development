					type: "item"
				}
			]
			title: "Steel Distillation Tower"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["23BC2F1468912FE3"]
			description: ["&eThe machine input receives rotation from the power network. The pumpjack crank converts that continuous rotation into the back-and-forth movement needed by the extraction assembly.&r"]
