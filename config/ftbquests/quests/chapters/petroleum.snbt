				"6B70EE9075BB5385"
				"25D0B69D3F5EBC20"
			]
			description: ["&eCrude oil contains hydrocarbons with different chain lengths and boiling behavior. The pumpjack recovers this mixed resource; the steel distillation tower separates it into fuels and chemical feedstocks.&r"]
			disable_toast: true
