			}]
			title: "Molten Polyvinyl Chloride"
			x: 8.0d
			y: -2.0d
		}
		{
			dependencies: ["49ACE7B6A81987AA"]
			dependency_requirement: "one_completed"
			description: ["&ePolymerization joins ethylene molecules into polyethylene chains. The molten product remains workable, allowing a casting mold to turn the polymer into solid stock or sheets.&r"]
			disable_toast: true
			id: "44136ADDCD8EAD4F"
			subtitle: "Polyethylene Polymerization"
			tasks: [{
				id: "66A3A164A1070989"
