			}]
			title: "Synthetic Leather"
			x: 6.0d
			y: 4.0d
		}
		{
			dependencies: ["21FEFC379E961856"]
			description: ["&eBitumen is a viscous, hydrocarbon-rich binder. Its adhesive and water-resistant character makes it useful in paving and waterproofing; in asphalt mixture it holds gravel and slag together as a continuous surface.&r"]
			disable_toast: true
			id: "7D310A7F3C5FC0EF"
			subtitle: "Bituminous Binder"
			tasks: [{
				id: "2FD7717FA4A2C13F"
