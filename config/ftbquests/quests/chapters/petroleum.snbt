		{
			dependencies: ["44136ADDCD8EAD4F"]
			description: [
				"&ePolyethylene consists of long chains built from ethylene units. The chains turn a small gaseous molecule into a lightweight solid that can be shaped into sheets, containers, and other manufactured stock.&r"
				""
				"&eIts resistance to moisture and poor electrical conductivity make it familiar in packaging and insulation. The refinery supplies polyethylene in cast solid and sheet forms.&r"
			]
			disable_toast: true
			id: "307A621A21A3E63C"
			shape: "square"
			tasks: [{
				id: "08D6CDC7E43BC8DC"
