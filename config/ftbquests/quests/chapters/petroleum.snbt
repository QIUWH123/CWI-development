			}]
			title: "Bitumen"
			x: 2.0d
			y: 2.0d
		}
		{
			dependencies: ["7D310A7F3C5FC0EF"]
			description: ["&eAsphalt mixture combines gravel and slag with bitumen. The aggregate forms the solid body of the paving material, while the binder holds those particles together. Furnace slag gains a second use as construction stock.&r"]
			disable_toast: true
			id: "6E443BA43458D311"
			subtitle: "Binder and Aggregate"
