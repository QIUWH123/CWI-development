		{
			dependencies: ["28F5C1BA9431AF60"]
			description: [
				"&eEthylene is a small hydrocarbon with a carbon-carbon double bond. That bond allows molecules to join into long chains, making ethylene the starting monomer for polyethylene.&r"
				""
				"&eIt also supplies the carbon skeleton for the chlorinated intermediates used in PVC production. Petroleum cracking makes this useful small molecule from larger hydrocarbons.&r"
			]
			disable_toast: true
			id: "49ACE7B6A81987AA"
			subtitle: "Ethylene Recovery"
			tasks: [{
				id: "7D17880A3C2D58CE"
				item: "tfmg:ethylene_bucket"
				type: "item"
			}]
			title: "Ethylene"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["28F5C1BA9431AF60"]
			description: [
				"&ePropylene is the monomer used for polypropylene. Like ethylene, its double bond allows molecules to join into chains; the extra carbon group gives the resulting polymer a different structure and material behavior.&r"
				""
				"&eCracking products supply propylene, and removing hydrogen from propane provides another route to the same chemical feedstock.&r"
			]
			disable_toast: true
			id: "3FD32B9970D4E3D9"
			subtitle: "Propylene Recovery"
			tasks: [{
				id: "246CD4E629D90A01"
				item: "tfmg:propylene_bucket"
				type: "item"
			}]
			title: "Propylene"
			x: 8.0d
			y: 2.0d
		}
		{
			dependencies: ["49ACE7B6A81987AA"]
			description: [
				"&ePVC's chains are built from vinyl chloride, which already contains chlorine. Polymerization links those units into a thermoplastic that can be cast into solid stock and sheets.&r"
				""
				"&eMaking the monomer also recovers muriatic acid as a separate chemical output.&r"
			]
			disable_toast: true
			id: "56CD87E991F1847E"
			subtitle: "Chlorinated Polymer Stock"
			tasks: [{
				id: "04F087015BC8C95A"
