		}
		{
			dependencies: ["21FEFC379E961856"]
			description: [
				"&eRubber's elastic behavior makes it useful where a rigid metal joint would not seal or flex well. Rubber sheets supply the pump's sealing stock and other assemblies that accept rubber.&r"
				""
				"&eSulfur is used in the petroleum-to-rubber process. In ordinary rubber manufacture, sulfur forms links between polymer chains, helping the material retain its shape after stretching. Sheets also supply synthetic leather and string.&r"
			]
			disable_toast: true
			id: "301441864FC92B6B"
			shape: "square"
			subtitle: "Rubber from Petroleum Stock"
			tasks: [{
				id: "436EA8CE3140970E"
				item: "tfmg:rubber_sheet"
				type: "item"
			}]
			title: "Industrial Rubber"
			x: 6.0d
			y: 2.0d
		}
		{
			dependencies: ["301441864FC92B6B"]
			description: ["&eSynthetic leather uses rubber as a flexible base in place of animal hide. It serves recipes that accept leather, allowing the refinery to supply this material.&r"]
			disable_toast: true
			id: "1A19C3A9645CFCFF"
