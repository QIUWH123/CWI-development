	quests: [
		{
			description: [
				"&eThe petroleum manual covers surveying, pumpjack construction, fractionation, and reactions that turn crude oil into fuels and chemical feedstocks.&r"
				""
				"&eRefining separates the mixed resource into useful streams. Some supply combustion engines; others become feedstocks for plastics, rubber, and chemical manufacture.&r"
			]
			id: "23BC2F1468912FE3"
			invisible: true
			shape: "gear"
			size: 2.0d
			subtitle: "Refinery Operating Copy"
			tasks: [{
				id: "3781ED6D058AF3D4"
				item: "kubejs:petroleum_manual"
				type: "item"
			}]
			title: "Petroleum Engineering"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["23BC2F1468912FE3"]
			description: [
				"&eDistillation separates a mixture using differences in volatility. In a tower, vapor cools as it rises, allowing different petroleum fractions to be recovered through separate outlets.&r"
				""
				"&eThe tower handles crude oil and mixtures from later cracking reactions. Distillation separates their components; cracking changes the molecules chemically.&r"
				""
				"&ePlace the heat source beneath the tower's steel tanks and feed the mixture into the controller. Each outlet can stop distillation when full or void excess fluid; choose its mode according to whether that stream must be preserved.&r"
			]
			disable_toast: true
			hide_dependency_lines: true
			id: "71A1E5FE72C80780"
			shape: "hexagon"
			size: 1.5d
			tasks: [
				{
					id: "34FCFBD4406B91FC"
					item: "tfmg:steel_distillation_controller"
					type: "item"
