			x: 8.0d
			y: -4.0d
		}
		{
			dependencies: ["301441864FC92B6B"]
			description: ["&eSynthetic string turns manufactured rubber stock into a flexible strand. It supplies recipes that accept string and the manufacture of synthetic feathers.&r"]
			disable_toast: true
