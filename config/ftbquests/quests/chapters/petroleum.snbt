			x: 0.0d
			y: 2.0d
		}
		{
			dependencies: ["6E443BA43458D311"]
			description: ["&eAsphalt turns loose mineral aggregate into a bound paved surface for paths and factory yards. Its bituminous binder holds the aggregate together, while the liquid form allows the material to be handled before placement.&r"]
			disable_toast: true
			id: "6182694F6CB2E60A"
