		{
			dependencies: ["2BB7B30F3B59D458"]
			description: [
				"&eUse TFMG gasoline for compatible engines and fluid-fed burners. Combustion releases chemical energy as heat, which an engine turns into movement. This gasoline also supplies the fuel base for napalm.&r"
				""
				"&eCracking wax oil produces a mixture from which gasoline can be separated, turning heavier refinery stock into a lighter fuel.&r"
				""
				"&eThe separate gasoline from Create Diesel Generators is not accepted as engine fuel here.&r"
			]
			disable_toast: true
			id: "6B3B0E0C4983791F"
			subtitle: "Gasoline Recovery"
			tasks: [{
				id: "059B563E7C8F20F3"
				item: "tfmg:gasoline_bucket"
				type: "item"
			}]
			title: "Gasoline"
			x: 4.0d
			y: -2.0d
		}
		{
			dependencies: ["21FEFC379E961856"]
			description: [
				"&eLubrication oil forms a film between contacting machine parts. That film reduces friction and wear where cylinders, bearings, and other moving surfaces would otherwise rub directly against one another.&r"
				""
				"&eCylinder and fuel-injector assembly, diesel engines, and heavy machine cores use this oil to prepare their working parts.&r"
			]
			disable_toast: true
			id: "7E496F23593AA01F"
			subtitle: "Assembly Lubricant Reserve"
