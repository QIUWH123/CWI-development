			}]
			title: "Muddy Bamboo"
			x: -8.0d
			y: -8.0d
		}
		{
			dependencies: ["4F09B6C7A598452C"]
			description: [
				"&eMuddy sugar cane recovered from wet sediment offers another source of living planting stock. Its stalks can supply accessible sugars for food and fermentation once a plot is established.&r"
				"&eReserve the first planting before processing any cane for sugar.&r"
			]
			disable_toast: true
			id: "42AE62A2A0976533"
