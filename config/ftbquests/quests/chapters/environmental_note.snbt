			}]
			title: "Ripen Matter Fold"
			x: -12.5d
			y: -7.0d
		}
		{
			dependencies: ["3CECF5ADD3C91E4B"]
			description: [
				"&eWet biological sediment occurs in lakes and oceans. Search beneath the water for preserved organic material.&r"
				"&eCrushing can release compost mass, muddy bamboo or sugar cane, Nitrofix Rhizobium, bone fragments, and mineral powder. Individual samples do not contain every useful component.&r"
			]
			hide_dependency_lines: true
			id: "4F09B6C7A598452C"
			size: 1.5d
			subtitle: "Search Under Water"
			tasks: [{
				id: "3B44DBB0C05CFCD4"
				item: "kubejs:wet_biological_sediment"
				type: "item"
			}]
			title: "Wet Biological Sediment"
			x: -8.0d
			y: -6.0d
		}
		{
			dependencies: ["4F09B6C7A598452C"]
			description: [
				"&eBones contain calcium phosphate, a useful source of phosphorus for plant growth. Wet, dry, and claystone biological sediments can yield bone fragments when crushed.&r"
				""
				"&ePhosphorus supports energy transfer and root development. Recovering this mineral from old remains gives soil conditioning a nutrient source that water and nitrogen alone cannot provide.&r"
			]
			disable_toast: true
			id: "13B4B488109EA835"
			tasks: [{
				id: "7622C180DC016850"
				item: "biomancy:bone_fragments"
				type: "item"
			}]
			title: "Bone Fragments"
			x: -6.5d
			y: -5.0d
		}
		{
			dependencies: ["4F09B6C7A598452C"]
			description: [
				"&eNitrofix Rhizobium recovered from wet biological sediment produces ammonia solution and converts it to nitrate solution for soil conditioning. A working culture can sustain this nitrogen supply.&r"
				"&ePlants need usable nitrogen to build proteins and chlorophyll. The culture's value lies in providing that supply, rather than merely surviving as a preserved sample.&r"
			]
			disable_toast: true
			id: "6C55B9E58C86102E"
			tasks: [{
				id: "651C0CFC6DF2ABA6"
				item: "kubejs:nitrofix_rhizobium"
				type: "item"
			}]
			title: "Nitrofix Rhizobium"
			x: -6.5d
			y: -7.0d
		}
		{
			dependencies: ["4F09B6C7A598452C"]
			description: ["&eBamboo preserved in wet sediment offers planting stock beneath the mud. Cleaning exposes usable material; a surviving shoot could establish a renewable supply of fibrous stems for sticks and wood stock.&r"]
			disable_toast: true
			id: "05E6809D0816FD73"
			tasks: [{
				id: "68A30675BEE1422E"
				item: "kubejs:muddy_bamboo"
