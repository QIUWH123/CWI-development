			x: -14.0d
			y: -10.0d
		}
		{
			dependencies: ["6A6DF9304AB7EA15"]
			description: ["&eThis solid stock is processed into mature matter, which lets a spreader support breeding and the growth of young animals. The finished matter, rather than the fold, is what the spreader can distribute.&r"]
			disable_toast: true
			id: "3432EC274FFBCBDD"
			tasks: [{
				id: "471E9B755529D5FA"
