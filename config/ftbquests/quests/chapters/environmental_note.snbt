		{
			dependencies: ["3CECF5ADD3C91E4B"]
			description: [
				"&ePeat stores partly decomposed plant material. In nature it accumulates where wet, oxygen-poor conditions slow decay, retaining carbon that would otherwise return more quickly to the environment.&r"
				"&eThe culture-assisted carbon line uses this organic stock as a starting material for its coal supply.&r"
			]
			disable_toast: true
