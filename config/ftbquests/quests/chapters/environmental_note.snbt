			title: "Stone Powder"
			x: -8.0d
			y: -4.0d
		}
		{
			dependencies: ["6C55B9E58C86102E"]
			description: [
				"&eNitrate supplies nitrogen in a form plants can absorb and use to build proteins and other essential compounds. In solution it can move with water through a growing medium to the roots.&r"
				"&eIn soil conditioning, its nitrogen contribution complements the mineral nutrients recovered from bone and sediment.&r"
			]
			disable_toast: true
			icon: "tfmg:nitrate_dust"
			id: "12F9EB602769BA20"
			tasks: [{
				id: "7827187BED26C0ED"
				item: "kubejs:nitrate_solution_bucket"
				type: "item"
			}]
			title: "Nitrate Solution"
			x: -5.0d
			y: -8.0d
		}
		{
			dependencies: ["13B4B488109EA835"]
			description: ["&eGround bone is easier to distribute through a soil preparation than intact fragments, exposing more of its calcium-phosphate mineral to the surrounding material. It supplies bone-meal production and can also serve as white pigment stock.&r"]
			disable_toast: true
			id: "006AA70EA1916072"
			subtitle: "The Fertilizer Intermediate"
			tasks: [{
				id: "7E99FDE8E3CDAAA0"
				item: "kubejs:bone_powder"
