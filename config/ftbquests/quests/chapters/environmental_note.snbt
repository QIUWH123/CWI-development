		}
		{
			dependencies: ["6A6DF9304AB7EA15"]
			description: ["&eThis compact intermediate supplies ripen matter for plant growth. The spreader uses the finished matter, rather than the fold, to distribute treatment across the growing plot.&r"]
			disable_toast: true
			id: "721B0A23FFEC5265"
			tasks: [{
				id: "2937857EDAFC031C"
				item: "ratatouille:ripen_matter_fold"
