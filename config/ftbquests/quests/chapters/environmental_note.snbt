	id: "06D805E239F1619C"
	order_index: 4
	quest_links: [ ]
	quests: [
		{
			description: [
				"&eRestoration working notes. The immediate aim is a plot that produces food; rebuilding a lasting ecosystem is a separate question. The soil treatments and culture procedures below give us a place to begin.&r"
				""
				"&eThese plans join laboratory processes to materials that may still be recovered outside. We have no long-term survival record for a person depending on such a farm.&r"
			]
			hide_dependent_lines: true
			icon_scale: 0.9d
			id: "3CECF5ADD3C91E4B"
			invisible: true
			shape: "gear"
			size: 3.0d
			tasks: [{
				id: "20CD82AF48E6B62A"
				item: "kubejs:environmental_note"
				type: "item"
			}]
			title: "Environmental Notes"
			x: -8.0d
			y: 0.0d
		}
		{
			dependencies: ["3CECF5ADD3C91E4B"]
			description: [
				"&eThe surface dirt has lost the structure and organic content expected of productive soil. It remains useful as a source of ash and buried remnants, but a dry mineral layer cannot provide everything a crop needs.&r"
				"&eWater by itself makes soaked depleted dirt. Nutrients and biological treatment are still needed before planting.&r"
			]
			hide_dependency_lines: true
			id: "5787AF3D0A2E4728"
			shape: "rsquare"
			size: 1.5d
			subtitle: "The Barren Surface"
			tasks: [{
				id: "23B347D0F2B68326"
				item: "kubejs:depleted_dirt"
				type: "item"
			}]
			title: "Depleted Dirt"
			x: -2.0d
			y: 0.0d
		}
		{
			dependencies: [
				"5C856CCA4F078AA9"
				"60BE07D84D003F04"
				"761160110BAD09FD"
			]
			description: [
				"&eUsable dirt gives roots a medium that holds moisture and carries nutrients. Soil conditioning supplies the nitrogen and bone-derived mineral contribution missing from the prepared ground, allowing it to support planting.&r"
				""
				"&eA first harvest should tell us more than the appearance of the soil. Whether a field can remain productive over many seasons is still an open question.&r"
			]
			disable_toast: true
			id: "2DD3C94512042C0F"
			shape: "rsquare"
			size: 1.5d
			subtitle: "Restored Growing Ground"
			tasks: [{
				id: "516B778143F5D72C"
				item: "minecraft:dirt"
				type: "item"
			}]
			title: "Dirt"
			x: 7.0d
			y: 0.0d
		}
		{
			dependencies: ["58E9697AC16F146C"]
			description: [
				"&eRich soil contains decomposed organic material and can be tilled into farmland that promotes crop growth. Decomposition makes nutrients more available, while organic matter helps the soil hold moisture and retain a workable structure.&r"
				""
				"&eOrganic compost matures into this medium after being placed. Nearby water and suitable surrounding blocks assist that decomposition.&r"
				""
				"&eThis is the soil we would hope to expand beyond a trial plot. A dark, crumbly sample is encouraging, but it is not evidence that the surrounding land has recovered.&r"
			]
			disable_toast: true
			id: "5AE545956D2B2D20"
			shape: "rsquare"
			size: 1.5d
			subtitle: "Compost Becomes Soil"
			tasks: [{
				id: "1D144224E3ADE9F4"
				item: "farmersdelight:rich_soil"
				type: "item"
			}]
			title: "Rich Soil"
			x: 13.0d
			y: 0.0d
		}
		{
			dependencies: ["3CECF5ADD3C91E4B"]
			description: [
				"&eThe faint light on a cave wall can mark glow lichen. Collect it with shears and retain the colony for soil treatment.&r"
				""
				"&eGlow lichen provides a reusable biological starter for the raw-soil treatment. Lichens can colonize exposed mineral surfaces in nature; the cave colony's persistence makes it a promising starting point for restoration work.&r"
			]
			disable_toast: true
			hide_dependency_lines: true
			id: "3DCE698C59DE0C7C"
			subtitle: "A Living Starter"
			tasks: [{
				id: "1E53AD09D723B82D"
				item: "minecraft:glow_lichen"
				type: "item"
			}]
			title: "Glow Lichen"
			x: 2.5d
			y: -1.0d
		}
		{
			dependencies: ["5787AF3D0A2E4728"]
			description: ["&eMoisture penetrates the depleted ground and allows dissolved substances to move through it. This makes the material suitable for biological treatment, although wetting alone does not restore lost nutrients or organic matter.&r"]
			disable_toast: true
			id: "14669168D99B9CA0"
			shape: "rsquare"
			size: 1.5d
			tasks: [{
				id: "508795C263D0E494"
				item: "kubejs:soaked_depleted_dirt"
				type: "item"
			}]
			title: "Soaked Depleted Dirt"
			x: 1.0d
			y: 0.0d
		}
		{
			dependencies: [
				"14669168D99B9CA0"
				"3DCE698C59DE0C7C"
			]
			description: ["&eLichen treatment prepares the depleted ground for further conditioning. Raw soil still needs available nutrients before it can support planting.&r"]
			disable_toast: true
			id: "5C856CCA4F078AA9"
			shape: "rsquare"
			size: 1.5d
			subtitle: "The Soil Intermediate"
			tasks: [{
				id: "4E1ABB921C950BEF"
				item: "kubejs:raw_soil"
				type: "item"
			}]
			title: "Raw Soil"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["5787AF3D0A2E4728"]
			description: [
				"&eThreshing depleted dirt has a small chance of recovering an arthropod. The remains offer a little protein while a crop is being established.&r"
				"&7Allow for many empty batches. A food plan cannot assume that the next handful of dirt contains anything edible.&r"
			]
			disable_toast: true
			id: "5A983ABB2A279DFE"
			subtitle: "Food From Threshing"
			tasks: [{
				id: "4AC542FCDF413AA8"
				item: "miners_delight:arthropod"
				type: "item"
			}]
			title: "Arthropod"
			x: -2.0d
			y: 2.0d
		}
		{
			dependencies: ["4F09B6C7A598452C"]
			description: [
				"&eCompost mass recovered from wet biological sediment provides organic material for decomposition. The process recovers useful solids, nutrient-bearing liquid and combustible gas from the same old biological stock.&r"
				""
				"&eFermentation produces compost residue, biogas, and compost tea. An active Putrelys Sporogenes culture accelerates the treatment; the slower process can run without it.&r"
			]
			disable_toast: true
			id: "4095EF2352EAD14C"
			tasks: [{
				id: "4EEAB0B2047CC408"
				item: "ratatouille:compost_mass"
				type: "item"
			}]
			title: "Compost Mass"
			x: -9.5d
			y: -7.0d
		}
		{
			dependencies: ["4095EF2352EAD14C"]
			description: ["&eCompost residue is the solid fraction of fermentation. It can be milled into biomass, mixed into organic compost, or converted to peat by active Putrelys Sporogenes. Collect the accompanying gas and tea as separate outputs.&r"]
			disable_toast: true
			id: "6A6DF9304AB7EA15"
			tasks: [{
				id: "7B0B56F81F9D64A1"
				item: "ratatouille:compost_residue"
				type: "item"
			}]
			title: "Compost Residue"
			x: -11.0d
			y: -8.0d
		}
		{
			dependencies: ["5FFC1ABF7B74F16E"]
			description: ["&eSugar is a food ingredient and an accessible carbon feedstock for cultures. Its relatively small molecules are easier to use in fermentation than intact woody tissue, making a sugar supply useful for alcohol production and other biological work.&r"]
			disable_toast: true
			id: "645DB368A9D15AD7"
			tasks: [{
				id: "67F4F2A6921F4BD8"
				item: "minecraft:sugar"
				type: "item"
			}]
			title: "Sugar"
			x: -12.5d
			y: -3.0d
		}
		{
			dependencies: ["4095EF2352EAD14C"]
			description: [
				"&eBiogas carries part of the organic feedstock's stored energy as a combustible gas. Compost decomposition and the local wood-processing line supply it; a fluid-fed blaze burner can turn it into workshop heat.&r"
				""
				"&eGas recovery gives the biological line an energy use alongside its soil products. A fuel reserve would help keep the apparatus running between harvests.&r"
			]
			disable_toast: true
			id: "31891D15D0EA187C"
			tasks: [{
				id: "0CB18B7FBD068C4F"
				item: "ratatouille:bio_gas_bucket"
				type: "item"
			}]
			title: "Biogas"
			x: -9.5d
			y: -9.0d
		}
		{
			dependencies: ["7DAB92C0947C10CB"]
			description: [
				"&eBiodiesel brings energy stored in biological feedstock into a liquid engine fuel. Compatible diesel engines convert its combustion into rotation, allowing the farm to contribute to its own machinery's power supply.&r"
				"&eIt also fuels supported portable equipment. A crop-derived supply could supplement oil reserves once a productive plot is established.&r"
			]
			disable_toast: true
			id: "6F0159783AE33348"
			tasks: [{
				id: "5AC9117B4AEAD36A"
				item: "createdieselgenerators:biodiesel_bucket"
				type: "item"
			}]
			title: "Biodiesel"
			x: -14.0d
			y: 0.0d
		}
		{
			dependencies: ["645DB368A9D15AD7"]
			description: [
				"&eBioethanol fuels liquid-fed blaze burners for superheating, supplying the stronger heat required by advanced processing. It brings the plant material's stored energy into the workshop as a renewable industrial fuel.&r"
				""
				"&eFermento Mycetes produces the separate ethanol used in biodiesel manufacture.&r"
			]
			disable_toast: true
			id: "7B2AC3CE02DAA69C"
			subtitle: "Biomass-Based Alcohol"
			tasks: [{
				id: "5B54932D01646ACC"
				item: "createaddition:bioethanol_bucket"
				type: "item"
			}]
			title: "Bioethanol"
			x: -11.0d
			y: -2.0d
		}
		{
			dependencies: ["5787AF3D0A2E4728"]
			description: ["&eFine ash is readily recovered from depleted dirt by milling, crushing, or threshing. Dry biological sediment releases it when crushed. Reserve some for ash bricks while separating the biological remains: the workshop and restoration work share this soil supply.&r"]
			disable_toast: true
			id: "0402F7A20A3CF9ED"
			tasks: [{
				id: "2F7E3642C002434C"
				item: "kubejs:ash"
				type: "item"
			}]
			title: "Ash"
			x: -0.5d
			y: 1.0d
		}
		{
			dependencies: ["4095EF2352EAD14C"]
			description: ["&eCompost tea carries the liquid fraction of the decomposing material, including dissolved nutrients. It supplies the crop-growth preparation, bringing this recovered biological material back into plant production.&r"]
			disable_toast: true
			id: "0DD993D89E7FDA58"
			tasks: [{
				id: "39CF7FE1F9EDD473"
				item: "ratatouille:compost_tea_bucket"
				type: "item"
			}]
			title: "Compost Tea"
			x: -11.0d
			y: -6.0d
		}
		{
			dependencies: ["645DB368A9D15AD7"]
			description: [
				"&eCultured ethanol supplies biodiesel manufacture, sterilizing fan catalysts and further chemical treatments. As an alcohol, it mixes with water and dissolves many organic substances, properties useful in cleaning and chemical processing.&r"
				"&eFermento Mycetes links the crop's accessible sugars to this alcohol supply, giving a food-producing plot another use in the workshop.&r"
			]
			disable_toast: true
			id: "7DAB92C0947C10CB"
			optional: true
			subtitle: "Microbial Alcohol"
			tasks: [{
				id: "7FC7257023D03D4D"
				item: "createdieselgenerators:ethanol_bucket"
				type: "item"
			}]
			title: "Ethanol"
			x: -14.0d
			y: -2.0d
		}
		{
			dependencies: [
				"43A681E4759A3D71"
				"2DD3C94512042C0F"
			]
			description: [
				"&eOrganic compost incorporates decomposable material into the soil supply. Decomposition releases nutrients from that material and contributes to a darker, more crumbly growing medium.&r"
				"&eIt matures into rich soil after being placed. Leave room for that maturation when planning the restoration plot.&r"
			]
			disable_toast: true
			id: "58E9697AC16F146C"
			shape: "rsquare"
			size: 1.5d
			tasks: [{
				id: "5F0CB18F51A2610D"
				item: "farmersdelight:organic_compost"
				type: "item"
			}]
			title: "Organic Compost"
			x: 10.0d
			y: 0.0d
		}
		{
			dependencies: ["0D14A252C4D9955C"]
			description: ["&eDried Fermento Mycetes is preserved starter material for an ethanol-producing culture, rarely recovered from dry biological sediment. Dry storage can slow biological activity, but the appearance of a sample does not by itself establish whether it remains viable.&r"]
			disable_toast: true
			hide_dependency_lines: true
			id: "0038547A05E5BB0A"
			tasks: [{
				id: "0E2D2AAB4812DBDD"
				item: "kubejs:dry_fermento_mycetes"
				type: "item"
			}]
			title: "Dried Fermento Mycetes"
			x: -5.0d
			y: 6.0d
		}
		{
			dependencies: ["0038547A05E5BB0A"]
			description: [
				"&eThe powdered sample disperses through a growth medium more evenly than a dry clump. Rehydration restores the water needed for cellular activity, while available nutrients support the first growth.&r"
				"&eThis is starter material for Fermento Mycetes. A revived working culture would establish the alcohol-fermentation supply.&r"
			]
			disable_toast: true
			id: "2124F945CC19830F"
			tasks: [{
				id: "53943C2AAD8FC12C"
