		}
		{
			dependencies: ["03C5FD608BA44B14"]
			description: [
				"&eBituminous coal is more coalified than lignite, with a greater carbon contribution and generally less moisture. It has long served as an industrial fuel, and suitable grades can supply coke.&r"
				"&eThe local material supports further culture-assisted carbon processing, linking organic recovery to the workshop's coal supply.&r"
			]
			disable_toast: true
