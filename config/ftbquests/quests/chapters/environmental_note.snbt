				type: "item"
			}]
			title: "Powdered Fermento Mycetes"
			x: -2.0d
			y: 6.0d
		}
		{
			dependencies: ["2124F945CC19830F"]
			description: [
				"&eAn active Fermento Mycetes culture converts accessible plant sugars into ethanol. Fermentation draws on the crop's stored carbon and energy, linking food production to liquid fuel and chemical feedstock.&r"
				""
				"&eThe culture remains after production. Establish a spare working sample before relying on fermentation for all fuel production.&r"
			]
			disable_toast: true
			id: "2886DC3B95FC59E8"
			subtitle: "An Active Fermentation Culture"
			tasks: [{
				id: "53702170B79F6F1A"
				item: "kubejs:fermento_mycetes"
				type: "item"
			}]
			title: "Fermento Mycetes"
			x: 1.0d
			y: 6.0d
		}
		{
			dependencies: ["6A6DF9304AB7EA15"]
			description: ["&eBiomass collects plant-derived material and compost residue into usable organic feedstock. Its carbon and stored chemical energy make it useful for bioethanol production, giving biological leftovers a role in the fuel supply.&r"]
			disable_toast: true
			id: "172963D5623889D6"
			tasks: [{
				id: "34E870276D77A01C"
