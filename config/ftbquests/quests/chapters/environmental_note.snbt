			x: -11.0d
			y: -10.0d
		}
		{
			dependencies: ["721B0A23FFEC5265"]
			description: ["&eA spreader distributes ripen matter to suitable plants, encouraging growth in the same practical role as repeated fertilizer application. It lets a powered apparatus tend part of the growing plot.&r"]
			disable_toast: true
			id: "075E454A2C75D143"
			subtitle: "Crop Growth Material"
			tasks: [{
				id: "2F8E5BD82020CC0B"
