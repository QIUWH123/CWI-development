			x: -9.5d
			y: -5.0d
		}
		{
			dependencies: ["4F09B6C7A598452C"]
			description: ["&eThe mineral powder separated from biological sediment supplies the mineral fraction of the bone-meal mix. Acidolys stone treatment can recover it as well. This powder has a different role from the individual rock powders used in geological processing.&r"]
			disable_toast: true
			id: "21A04E72207405AF"
			subtitle: "Mineral Additive"
