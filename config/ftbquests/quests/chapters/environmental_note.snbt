			title: "Ripen Matter"
			x: -14.0d
			y: -6.0d
		}
		{
			dependencies: ["3432EC274FFBCBDD"]
			description: ["&eMature matter lets a spreader encourage adult animals to breed and young animals to grow. It supports the renewal of an existing herd, providing another way to maintain food and biological material alongside the crop plot.&r"]
			disable_toast: true
			id: "0DBBCEEAD979BD5B"
			subtitle: "Animal Growth Material"
			tasks: [{
				id: "3F6F46E252AE9B24"
