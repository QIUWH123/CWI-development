			title: "Wood Chip Block"
			x: 4.5d
			y: -4.5d
		}
		{
			dependencies: ["012664D784F5D09D"]
			description: [
				"&eThe press turns shaft rotation into a downward stroke. Its broad head spreads force over a workpiece, flattening an ingot into a sheet for covers, blades, and other thin parts.&r"
				""
				"&eWith a basin below, the same stroke compacts a batch into a combined product. The basin contains the ingredients while the head applies pressure.&r"
			]
			disable_toast: true
			id: "4C5689F8A2DBC8A7"
			shape: "hexagon"
			size: 1.5d
			subtitle: "Powered Metalworking"
			tasks: [{
				id: "50FE3543D0720357"
				item: "create:mechanical_press"
				type: "item"
			}]
			title: "Mechanical Press"
			x: 8.5d
			y: -2.5d
		}
		{
			dependencies: ["5E402C739E34B7D4"]
			description: ["&eDamp clay is pliable enough to fill a mold and bind loose mineral grains together. This makes it useful in andesite compound, ash bricks, and casting molds; firing fixes the shaped clay into ceramic.&r"]
			disable_toast: true
			hide_dependency_lines: true
			id: "437113F4C591BBA5"
			subtitle: "A Binder for the Workshop"
			tasks: [{
				id: "20046B0DD94228D9"
