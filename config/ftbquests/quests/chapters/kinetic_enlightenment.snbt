			title: "Clay Balls"
			x: 0.5d
			y: -6.5d
		}
		{
			dependencies: ["540EF2A79DD1C92C"]
			description: ["&eFine andesite grains mix through clay more evenly than chunks of stone. The powder supplies the mineral part of andesite compound.&r"]
			disable_toast: true
