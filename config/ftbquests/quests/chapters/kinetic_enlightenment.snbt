		}
		{
			dependencies: ["5E402C739E34B7D4"]
			description: [
				"   &3----------&r   &bHold to Charge&r   &3----------&r"
				"   &3----------&r   &bRelease to Use&r   &3----------&r"
				""
				"&eA heavy hammer head delivers an impact that breaks brittle stone and ore or flattens a metal ingot on a depot. It supplies these operations by hand before a powered crusher or press is available.&r"
				""
				"&eThe rusted tool has fewer charge stages than the iron hammer.&r"
			]
			disable_toast: true
