	quests: [
		{
			description: ["&eA mechanical workshop puts rotation to work: crushing stone, shaping metal, and combining materials. Shafts carry power between machines; each machine turns that rotation into a different action.&r"]
			hide_dependent_lines: true
			id: "5E402C739E34B7D4"
			invisible: true
			shape: "gear"
			size: 2.0d
			subtitle: "Building the First Workshop"
			tasks: [{
				id: "5C61EFB7E7018D69"
				item: "kubejs:mechanic_manual"
				type: "item"
			}]
			title: "The Mechanical Workshop"
			x: -1.5d
			y: -2.5d
		}
		{
			dependencies: [
				"5E402C739E34B7D4"
				"42229A4123AA3541"
				"5E24F2344B85B318"
			]
			description: ["&eAndesite alloy supplies the shafts, cogwheels, and housings of early machinery. Firing the clay-andesite compound turns the loose mixture into solid stock that can be shaped into these parts.&r"]
			disable_toast: true
			id: "60E2563C494FB253"
			shape: "square"
			subtitle: "Stock for Mechanical Parts"
			tasks: [{
				id: "68F20F61C0740F10"
				item: "create:andesite_alloy"
				type: "item"
			}]
			title: "Andesite Alloy"
			x: 0.5d
			y: -2.5d
		}
		{
			dependencies: [
				"4C1F87459ED9C5F9"
				"437113F4C591BBA5"
				"476F895A01D30141"
			]
			description: ["&eClay binds the grains of andesite into a workable compound. It is the unfired stock for andesite alloy and can also take the shape of a sheet mold before firing.&r"]
			disable_toast: true
			id: "42229A4123AA3541"
			tasks: [{
				id: "76B728FDDEB6104A"
				item: "kubejs:andesite_compound"
				type: "item"
			}]
			title: "Andesite Compound"
			x: 0.5d
			y: -4.5d
		}
		{
			dependencies: [
				"1266E8AE2713DF7E"
				"701D21C32E77F5C7"
			]
			description: ["&eThe casing houses a machine's moving parts and gives the assembly a common body. A wood chip block supplies the core, with an andesite alloy sheet forming its outer covering.&r"]
			id: "6A11BA5D1C4D2924"
			shape: "rsquare"
			size: 1.75d
			subtitle: "A Body for Moving Parts"
			tasks: [{
				id: "1A72D3EA0EC250E4"
				item: "create:andesite_casing"
				type: "item"
			}]
			title: "Andesite Casing"
			x: 4.5d
			y: -2.5d
		}
		{
			dependencies: ["417DC65C679BBF74"]
			description: ["&eReassembled wood chips provide a solid body for casings and other wooden components. The block gives small recovered fragments a useful construction form when intact timber is scarce.&r"]
			disable_toast: true
			id: "1266E8AE2713DF7E"
			subtitle: "Rebuild a Solid Material"
			tasks: [{
				id: "3E4F84056AA52EA3"
				item: "createdieselgenerators:chip_wood_block"
				type: "item"
