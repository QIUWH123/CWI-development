		{
			dependencies: ["4D08D43112F8E50A"]
			description: ["&eThe mechanical pump turns shaft power into directed fluid movement, drawing from one side of a pipe and delivering to the other. Reversing its rotation reverses the flow, while higher speed increases the transfer rate.&r"]
			disable_toast: true
