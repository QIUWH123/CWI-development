		{
			dependencies: ["77638D6698CCC725"]
			description: [
				"&eSmall ore deposits occur throughout the Overworld, in both stone and deepslate. Iron, copper, coal, tin, zinc, nickel, lead, lithium, lapis and quartz have broad vertical ranges; gold, silver, redstone, sulfur and diamond occupy narrower ones.&r"
				""
				"&eThe listed heights give search ranges. Deposits may extend beyond them, and local terrain affects what can be found.&r"
			]
			disable_toast: true
			hide_dependency_lines: true
			icon: "minecraft:stone"
			id: "73F7C99EE4ABCE4F"
			size: 1.5d
