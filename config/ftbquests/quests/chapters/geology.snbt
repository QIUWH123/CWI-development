			x: 3.5d
			y: 9.0d
		}
		{
			dependencies: ["450EC9FCCFB49FA9"]
			description: [
				"&eBauxite is a rock composed chiefly of aluminum-bearing hydroxide minerals, often mixed with iron oxides and clay. It is an ore mixture, not a single mineral species.&r"
				""
				"&eOrdinary bands begin at Y 30-70. Sandy Caves carry more frequent bauxite deposits from Y -20 to 63. Bauxite supplies refined aluminum and is also a fireclay ingredient.&r"
			]
			disable_toast: true
