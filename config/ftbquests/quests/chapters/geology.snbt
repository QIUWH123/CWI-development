			y: -8.3d
		}
		{
			dependencies: ["73F7C99EE4ABCE4F"]
			description: [
				"&eSmall copper deposits occur from Y -63 to 160. Azurite, malachite and chalcocite are separate copper-bearing minerals.&r"
				""
				"&eCopper supports pipes, pumps and other fluid equipment. Its powder is also an ingredient of brass and bronze.&r"
			]
