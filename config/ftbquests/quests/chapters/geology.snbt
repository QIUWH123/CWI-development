			x: 4.9d
			y: 8.8d
		}
		{
			dependencies: ["450EC9FCCFB49FA9"]
			description: [
				"&eMagnetite is an iron oxide, Fe3O4. It is strongly magnetic; naturally magnetized pieces are known as lodestones.&r"
				""
				"&eOrdinary mineral bands begin at Y -63 to 0. Molten Caves have more frequent magnetite bands reaching Y 20. Physical separation recovers iron with possible vanadium and titanium byproducts.&r"
			]
			disable_toast: true
