			y: 8.8d
		}
		{
			dependencies: ["450EC9FCCFB49FA9"]
			description: [
				"&eCassiterite is tin dioxide, SnO2. Its high density makes gravity separation useful in real ore dressing, including deposits where weathering has concentrated heavy grains.&r"
				""
				"&eOrdinary bands begin at Y -40 to 0. Glowshroom Caves contain a more frequent variety at Y -63 to 50. Separation supplies tin with small molybdenum, copper and iron byproducts.&r"
			]
			disable_toast: true
