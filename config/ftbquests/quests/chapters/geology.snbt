		}
		{
			dependencies: ["450EC9FCCFB49FA9"]
			description: [
				"&eGalena, PbS, is a dense lead sulfide with a metallic luster and characteristic cubic cleavage. Some natural deposits also contain economically useful silver.&r"
				""
				"&eBands begin at Y -40 to 70 across several Overworld biomes, including Typical, Spider, Dripstone and Echo Caves.&r"
				""
				"&eSeparation or acid leaching supplies lead, with zinc and silver byproducts. Vibration and centrifugation also recover sulfur.&r"
			]
			disable_toast: true
