		{
			dependencies: ["009C96B36DFFDD5B"]
			description: [
				"&eSulfide minerals bind sulfur to metals. Galena, sphalerite, chalcocite and pentlandite are examples; their dark or metallic appearance can differ greatly from yellow elemental sulfur.&r"
				""
				"&eVibration and centrifugation of these minerals release sulfur dust alongside their metal products. This dust is distinct from the native sulfur powder used in gunpowder and pyrite preparation.&r"
			]
			disable_toast: true
			id: "424B057217E415F9"
