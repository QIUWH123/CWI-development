			title: "Azurite"
			x: 1.0d
			y: 3.0d
		}
		{
			dependencies: ["450EC9FCCFB49FA9"]
			description: [
				"&eChromite is an iron-chromium oxide, FeCr2O4, and the principal commercial ore of chromium. Magnesium can substitute for some iron in natural specimens.&r"
				""
				"&eOrdinary bands start at Y -63 to -30; Molten Caves bands extend to Y -20 and occur more frequently. Separation yields chromium with magnesium, iron and aluminum byproducts.&r"
			]
			disable_toast: true
			id: "348F7BF851E4C95E"
