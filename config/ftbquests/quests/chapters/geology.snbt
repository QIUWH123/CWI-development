		{
			dependencies: ["73F7C99EE4ABCE4F"]
			description: [
				"&eQuartz is silicon dioxide, SiO2, a common mineral in many igneous, sedimentary and metamorphic rocks.&r"
				""
				"&eQuartz-bearing ore is present in the Overworld from Y -63 to 160, as well as in Nether netherrack. Quartz supplies silica processing, rose quartz and crystal-growth feedstock.&r"
			]
			disable_toast: true
