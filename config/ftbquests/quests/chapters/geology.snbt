			x: 20.0d
			y: 0.0d
		}
		{
			dependencies: ["77638D6698CCC725"]
			description: [
				"&eLarge deposits contain alternating bands of mineral and surrounding rock. A colored or metallic band may therefore be only part of a much larger body.&r"
				""
				"&eTheir distribution depends on both depth and biome. Glowshroom Caves favor azurite, malachite and cassiterite; Sandy Caves favor bauxite and lignite; Molten Caves contain increased magnetite and chromite deposits.&r"
			]
			disable_toast: true
			hide_dependency_lines: true
			icon: "minecraft:stone"
			id: "450EC9FCCFB49FA9"
			size: 1.5d
