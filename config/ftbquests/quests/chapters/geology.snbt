		}
		{
			dependencies: ["73F7C99EE4ABCE4F"]
			description: ["&eIron ore occurs from Y -63 to 160 and is one of the more widespread metal ores. Raw iron powder is a smelting feedstock; larger hematite and magnetite bands provide additional iron-bearing minerals.&r"]
			disable_toast: true
			id: "2F94FFCC16D5C49D"
