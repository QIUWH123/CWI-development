			x: 3.5d
			y: 5.5d
		}
		{
			dependencies: ["450EC9FCCFB49FA9"]
			description: [
				"&eThe azurite here is mottled blue, with pale highlights and darker patches. Azurite is a copper carbonate mineral, Cu3(CO3)2(OH)2, that forms in oxidized copper deposits and may occur alongside malachite.&r"
				""
				"&eOrdinary azurite bands begin at Y 0-70. They are more frequent in Glowshroom Caves, where bands begin at Y -63 to 50.&r"
				""
				"&eAzurite powder supplies copper and a small silver byproduct. Both physical separation and sulfuric-acid leaching are available.&r"
			]
			disable_toast: true
			id: "5F134945AFC3583E"
			tasks: [{
				id: "23F5354AFA361E3C"
