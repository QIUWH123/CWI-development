		{
			dependencies: ["73F7C99EE4ABCE4F"]
			description: [
				"&eRedstone is the red mineral dust used for signals and control circuits. Small ore deposits occur between Y -63 and 63.&r"
				""
				"&eBeyond circuits, redstone is a feedstock for redstone acid and treated rose quartz. Brushing crystallized phyllite can release small quantities as well.&r"
			]
			disable_toast: true
