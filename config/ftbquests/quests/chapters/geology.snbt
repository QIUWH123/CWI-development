			y: -3.5d
		}
		{
			dependencies: ["009C96B36DFFDD5B"]
			description: [
				"&eQuartz crystals commonly have six-sided prisms. Different colors can result from impurities, inclusions or defects in the crystal structure.&r"
				""
				"&eQuartz occurs in Nether ore and in the Overworld deposits spanning Y -63 to 160. The crystals can be milled into powder or treated to make rose quartz.&r"
			]
			disable_toast: true
			id: "364041AAD78EB3A1"
