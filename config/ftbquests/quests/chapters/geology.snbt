		{
			dependencies: ["73F7C99EE4ABCE4F"]
			description: ["&eNickel ore occurs from Y -63 to 160. Raw nickel powder supplies smelted nickel; pentlandite offers a separate source with cobalt and iron byproducts. Nickel is useful in alloys and chemical catalysts, and combines with copper to form constantan.&r"]
			disable_toast: true
